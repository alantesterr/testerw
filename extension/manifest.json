{
  "manifest_version": 3,
  "name": "StudyPlay — тесты во время видео",
  "version": "1.0.0",
  "description": "Пока ты смотришь видео на любом сайте, через заданное время ставит его на паузу и задаёт вопросы из «Экзамена» StudyPlay.",
  "icons": { "128": "icon.png" },
  "action": { "default_popup": "popup.html", "default_icon": "icon.png", "default_title": "StudyPlay: тесты во время видео" },
  "permissions": ["storage", "unlimitedStorage", "tabs"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" },
    { "matches": ["https://alantesterr.github.io/testerw/exam/*", "http://localhost:8099/exam/*"], "js": ["bridge.js"], "run_at": "document_start" }
  ]
}
